# AEROTWIN AI - Environment Variables Example
# Copy this file to .env before starting the services

# Port Configurations
PORT=5000
FRONTEND_PORT=3000
AI_SERVICE_PORT=8000

# Database Configuration (PostgreSQL)
# If left blank, the backend automatically uses embedded zero-setup persistence
DATABASE_URL=postgresql://aerotwin_user:aerotwin_password@localhost:5432/aerotwin_db

# Security & JWT Secrets
JWT_SECRET=aerotwin-jwt-secret-key-2026-maledrone

# AI Service Microservice URL
AI_SERVICE_URL=http://localhost:8000

# Grok / xAI API Configuration
# Enter your xAI API key to enable live Grok-2 propulsion decision support.
# If omitted or left empty, the application automatically runs in Offline Aerospace Knowledge Engine mode!
XAI_API_KEY=your_xai_api_key_here
